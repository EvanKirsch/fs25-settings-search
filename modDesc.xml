<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<modDesc descVersion="111" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/modDesc.xsd">
  <author>Evan Kirsch</author>
  <version>0.0.0.1</version>
  <title>
      <en>Settings Search</en>
      <de>Einstellungssuche</de>
  </title>
  <description>
    <en><![CDATA[
Adds a live search box to the in-game settings menu so you can quickly find a setting by name instead of scrolling through the whole list.

GitHub link: https://github.com/EvanKirsch/fs25-settings-search
    ]]></en>
    <de><![CDATA[
Fügt dem Einstellungsmenü ein Live-Suchfeld hinzu, mit dem du eine Einstellung schnell anhand ihres Namens findest, anstatt die gesamte Liste zu durchsuchen.

GitHub-Link: https://github.com/EvanKirsch/fs25-settings-search
    ]]></de>
  </description>
  <iconFilename>icon_SettingsSearch.dds</iconFilename>
  <l10n filenamePrefix="translations/translation" />
  <multiplayer supported="true"/>
  <extraSourceFiles>
    <sourceFile filename="src/hotkeys/SS_toggleSearchHotkey.lua" />
    <sourceFile filename="src/hotkeys/SS_clearSearchHotkey.lua" />
    <sourceFile filename="src/SS_settingsSearch.lua" />
  </extraSourceFiles>
  <actions>
    <action name="SS_TOGGLE_SEARCH" category="MENU"/>
    <action name="SS_CLEAR_SEARCH" category="MENU"/>
  </actions>
  <inputBinding>
    <actionBinding action="SS_TOGGLE_SEARCH">
      <binding device="KB_MOUSE_DEFAULT" input="KEY_s" />
    </actionBinding>
    <actionBinding action="SS_CLEAR_SEARCH">
      <binding device="KB_MOUSE_DEFAULT" input="KEY_r" />
    </actionBinding>
  </inputBinding>
</modDesc>
